<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}" /> | Invoice Generator</title>
    <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<body>

<c:if test="${not empty sessionScope.loggedUser}">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="${ctx}/dashboard">Invoice Generator</a>
            <nav class="nav">
                <a href="${ctx}/dashboard" class="${activeMenu eq 'dashboard' ? 'active' : ''}">Dashboard</a>
                <a href="${ctx}/customers" class="${activeMenu eq 'customers' ? 'active' : ''}">Customers</a>
                <a href="${ctx}/products" class="${activeMenu eq 'products' ? 'active' : ''}">Products</a>
                <a href="${ctx}/invoices" class="${activeMenu eq 'invoices' ? 'active' : ''}">Invoices</a>
            </nav>
            <div class="user-box">
                <span>Hello, <c:out value="${sessionScope.loggedUser.fullName}" /></span>
                <a class="btn btn-light btn-sm" href="${ctx}/logout">Logout</a>
            </div>
        </div>
    </header>
</c:if>

<main class="container">

    <%-- One-time messages saved in the session by the servlets, shown once, then removed --%>
    <c:if test="${not empty sessionScope.flashSuccess}">
        <div class="alert alert-success"><c:out value="${sessionScope.flashSuccess}" /></div>
        <c:remove var="flashSuccess" scope="session" />
    </c:if>
    <c:if test="${not empty sessionScope.flashError}">
        <div class="alert alert-error"><c:out value="${sessionScope.flashError}" /></div>
        <c:remove var="flashError" scope="session" />
    </c:if>